{
  "rules": {
    "matches": {
      "$matchId": {
        ".read": "auth != null && (data.child('players').hasChild(auth.uid) || data.child('created_by').val() == auth.uid || !data.exists())",
        ".write": "auth != null",
        "secret": {
          ".read": "auth != null && data.parent().child('created_by').val() == auth.uid"
        },
        "answer": {
          ".read": "auth != null && (data.parent().child('players').hasChild(auth.uid) || data.parent().child('created_by').val() == auth.uid)"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    }
  }
}
