{
  "rules": {
    "lobby": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "matches": {
      "$matchId": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "progress": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "found": {
              ".validate": "newData.isBoolean()"
            },
            "rounds": {
              "$roundIndex": {
                "progress": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                }
              }
            }
          }
        }
      }
    }
  }
}
