{
  "rules": {
    "lobby": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      },
      "stats": {
        ".read": "auth != null",
        "online": {
          ".read": "auth != null",
          ".write": "false"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "matches": {
      ".indexOn": ["phase"],
      "$matchId": {
        // C3 — Lecture restreinte aux participants : un tiers ne peut plus
        // enumerer les duels en cours ni lire leur contenu.
        ".read": "auth != null && (data.child('players').child(auth.uid).exists() || data.child('target_uid').val() === auth.uid || data.child('created_by').val() === auth.uid)",
        // C1 — Ecriture top-level reservee aux participants. Les writes de
        // progression passent par la regle enfant players/$uid. TOUS les champs
        // sensibles (winner, phase, rounds, current_round, is_ranked, secret...)
        // sont verrouilles par le `$otherMatchField: {".validate": false}`
        // ci-dessous : seul le serveur (Admin SDK, qui bypass les rules) peut
        // les ecrire. Join, transitions de phase et forfait passent par des
        // Cloud Functions (joinDuel, advancePhase, submitRoundWin/Timeout,
        // forfeitMatch).
        //
        // Anti-grief (suppression) : la SUPPRESSION du noeud (newData null) est
        // limitee au CREATEUR et UNIQUEMENT en phase `waiting` (cas legitime
        // deleteIfOwner : nettoyer un duel QR que personne n'a rejoint). Un
        // participant ne peut donc PAS supprimer un duel en cours pour priver
        // l'adversaire de sa victoire. Les suppressions serveur (CF) bypassent.
        ".write": "auth != null && (data.child('players').child(auth.uid).exists() || data.child('target_uid').val() === auth.uid || data.child('created_by').val() === auth.uid) && (newData.exists() || (data.child('created_by').val() === auth.uid && (!data.child('phase').exists() || data.child('phase').val() === 'waiting')))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            // Le client ne peut ecrire QUE sa progression (barre adverse).
            // rounds_won / total_time_ms / found / finished_at sont serveur-only.
            "progress": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "rounds": {
              "$roundIndex": {
                "progress": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                },
                "$otherRoundField": { ".validate": false }
              }
            },
            "$otherPlayerField": { ".validate": false }
          }
        },
        // Tout champ du match non explicitement autorise ci-dessus est
        // refuse en ecriture client (Admin SDK bypass pour les CFs).
        "$otherMatchField": { ".validate": false }
      }
    },
    "match_answers": {
      // C2/C3 — Reponses des duels, serveur-only. Aucune regle d'acces =>
      // refuse cote client par defaut ; lu/ecrit uniquement par les Cloud
      // Functions via l'Admin SDK. Revele dans /matches/.../rounds/{i}/answer
      // seulement en fin de manche.
      ".read": false,
      ".write": false
    },
    "pending_challenges": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
