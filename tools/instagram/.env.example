# Copie ce fichier en .env et remplis les valeurs. NE COMMITTE JAMAIS .env.
IG_USER_ID=
IG_ACCESS_TOKEN=          # token longue durée (~60 j) — obtenu via --exchange-token
IG_APP_ID=
IG_APP_SECRET=
GRAPH_HOST=graph.instagram.com   # graph.facebook.com si voie "Facebook login"
GRAPH_VERSION=v21.0

# Uniquement pour l'échange initial (--exchange-token), à retirer ensuite :
# IG_SHORT_TOKEN=
