{
  "name": "kilimandjaro-functions",
  "version": "0.1.0",
  "description": "Cloud Functions v2 — matchmaking ELO, curation, anti-cheat",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .js,.ts src/ || true",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:devinettes": "node scripts/seed_devinettes.js",
    "seed:devinettes:dry": "node scripts/seed_devinettes.js --dry-run",
    "seed:daily": "node scripts/seed_daily_challenges.js",
    "seed:daily:dry": "node scripts/seed_daily_challenges.js --dry-run",
    "test": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPattern=integration --runInBand",
    "test:all": "jest --runInBand"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.0",
    "firebase-functions-test": "^3.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.json"
      }
    }
  },
  "private": true
}
