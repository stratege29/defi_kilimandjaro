rules_version = '2';

// =============================================================================
// Storage rules — Kilimandjaro
// -----------------------------------------------------------------------------
// Stratégie :
//   - `packs/v2/{packId}/image.{ext}` : lecture publique (CDN), écriture par
//     admin uniquement (claim `role == 'admin'`). Couvre les illustrations
//     packs uploadées via le backoffice. Note : en Storage rules les
//     règles spécifiques sont évaluées avant les wildcards plus larges, donc
//     elles peuvent autoriser un write là où le bloc parent l'interdit.
//   - `packs/` (gz OTA + reste) : lecture publique, écriture refusée — les
//     blobs gz sont écrits via Admin SDK (Cloud Function `publishPack`) qui
//     bypasse les règles.
//   - Tout le reste : deny par défaut.
// =============================================================================
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.role == 'admin';
    }

    // Image d'illustration d'un pack (uploadée depuis le backoffice).
    // Un seul fichier par pack, overwrite à chaque upload.
    // Limites : 1 MiB max post-optimisation (la pipeline cible < 80 KiB),
    // content-type image/webp ou image/png ou image/jpeg.
    // Le filename est matché par regex (image.{webp,png,jpg,jpeg}) plutôt
    // qu'avec {ext} qui n'est pas supporté par les Storage rules.
    match /packs/v2/{packId}/{filename} {
      allow read: if true;
      allow write: if isAdmin()
        && filename.matches('image\\.(webp|png|jpg|jpeg)')
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin()
        && filename.matches('image\\.(webp|png|jpg|jpeg)');
    }

    match /packs/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
