rules_version = '2';

// =============================================================================
// Firestore security rules — Kilimandjaro
// -----------------------------------------------------------------------------
// Domaines :
//   - profiles / friendships / matches_history : duels ELO (PR-4)
//   - content_index / content_packs           : manifest pack devinettes
//   - submissions / submissions_moderation     : UGC pipeline
//   - reports                                  : flagging communautaire
//   - users_quota / ip_quota                   : rate-limiter Functions
//
// Tous les writes côté client passent par App Check (sauf debug).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isModerator() {
      return isSignedIn()
        && (request.auth.token.role == 'moderator'
            || request.auth.token.role == 'admin');
    }

    // Backoffice content roles (Phase 1) — cf docs/backoffice_schema.md §6
    function isEditor() {
      return isSignedIn()
        && (request.auth.token.role == 'editor'
            || request.auth.token.role == 'admin');
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.role == 'admin';
    }

    // Propriétaire de la page Instagram (tableau de bord croissance).
    function isPageOwner() {
      return isSignedIn()
        && request.auth.token.email == 'arnaudkossea@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // File de publication Instagram — gérée par le tableau de bord (propriétaire)
    // et par les Cloud Functions (Admin SDK). Aucun autre accès.
    match /instagram_queue/{postId} {
      allow read, write: if isPageOwner() || isAdmin();
    }

    // Galerie d'images IA générées (écrite par Cloud Function / Admin SDK).
    match /ai_images/{imgId} {
      allow read: if isPageOwner() || isAdmin();
      allow write: if false;
    }

    // Réglages Instagram (ex. autopilote on/pause) — lu par le dashboard,
    // écrit uniquement par Cloud Function (igSetAutopilot, Admin SDK).
    match /instagram_meta/{docId} {
      allow read: if isPageOwner() || isAdmin();
      allow write: if false;
    }

    // Stories Instagram (file dédiée) — lue par le dashboard, écrite uniquement
    // via Cloud Function / Admin SDK (seed + publication).
    match /instagram_stories/{storyId} {
      allow read: if isPageOwner() || isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Profils joueurs — PR-4
    // -------------------------------------------------------------------------
    // Lecture publique pour afficher l'ELO dans le lobby.
    // Écriture ELO/stats UNIQUEMENT via Admin SDK (Cloud Functions endMatch / requestMatch).
    // Exception : le client peut écrire uniquement fcm_token et fcm_updated_at
    // (nécessaire pour l'enregistrement FCM côté app, sans passer par une CF).
    match /profiles/{uid} {
      allow read: if request.auth != null;

      // Écriture générale bloquée (Admin SDK seulement).
      allow write: if false;

      // Champs éditables client-side sur son propre profil :
      //   - fcm_token / fcm_updated_at        → enregistrement FCM
      //   - display_name / display_name_updated_at → pseudo leaderboard
      //   - avatar_id / avatar_updated_at     → choix d'avatar (catalogue fini,
      //     pas de validation côté serveur — id arbitraire string < 64 chars)
      // Les champs ELO/wins/losses/total_duels/peakElo restent Admin SDK-only.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'fcm_token', 'fcm_updated_at',
               'display_name', 'display_name_updated_at',
               'avatar_id', 'avatar_updated_at'
             ])
        && (!('avatar_id' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.avatar_id is string
                && request.resource.data.avatar_id.size() <= 64));

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys()
             .hasOnly([
               'fcm_token', 'fcm_updated_at',
               'display_name', 'display_name_updated_at',
               'avatar_id', 'avatar_updated_at'
             ]);

      // Duel history subcollection — read-only by owner.
      // Written only by Cloud Function endMatch (Admin SDK).
      match /duel_history/{matchId} {
        allow read: if request.auth != null
          && request.auth.uid == uid;
        allow write: if false;
      }

      // Badges cosmétiques de tournoi — lecture publique (affichés sur le
      // profil/leaderboard), écriture UNIQUEMENT via Cloud Function
      // (tournamentTicker, Admin SDK).
      match /badges/{badgeId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Tournois « arène » — mode multi-joueurs temporisé
    // -------------------------------------------------------------------------
    // Lecture publique signed-in (liste, compte à rebours, nb participants,
    // classement live). Toutes les écritures passent par les Cloud Functions
    // (createTournament/joinTournament/requestArenaMatch/tournamentTicker via
    // Admin SDK) : aucun client ne peut créer un tournoi, s'attribuer des points,
    // ni modifier un classement.
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /participants/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Friendships (unidirectional follow) — PR-4
    // -------------------------------------------------------------------------
    // friendships/{follower_uid}/{followed_uid} : { created_at: timestamp }
    // Le follower crée/supprime ses propres entrées. Lecture publique.
    match /friendships/{followerUid}/followed/{followedUid} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
        && request.auth.uid == followerUid;
      allow update: if false;
    }

    // -------------------------------------------------------------------------
    // Historique des matchs — PR-4
    // -------------------------------------------------------------------------
    // Lecture autorisée aux participants du match uniquement.
    // Écriture UNIQUEMENT via Admin SDK (Cloud Function endMatch).
    match /matches_history/{matchId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.players;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Manifest packs devinettes — lecture publique, écriture serveur uniquement
    // -------------------------------------------------------------------------
    match /content_index/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /content_packs/{packId} {
      allow read: if true;
      allow write: if false;

      match /versions/{versionId} {
        allow read: if isModerator();
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Devinettes (seed Firestore pour duel 1v1) — serveur uniquement
    // -------------------------------------------------------------------------
    // Anti-cheat: les devinettes sont seedées en Firestore par Cloud Functions
    // et consultées UNIQUEMENT par les CF (admin SDK). Les clients ne doivent
    // JAMAIS accéder directement — les devinettes du duel leur arrivent via
    // Realtime DB dans /matches/{matchId}, qui est source de vérité côté CF.
    match /devinettes/{devinetteId} {
      allow read, write: if false;  // serveur uniquement (admin SDK bypass)
    }

    // -------------------------------------------------------------------------
    // Daily challenges — pool curated cross-joueurs
    // -------------------------------------------------------------------------
    // Lecture publique (cohérent avec content_index/content_packs) : tous les
    // joueurs lisent le doc `{yyyy-MM-dd}` du défi du jour. Pas d'auth requise
    // — le contenu n'est pas sensible et le mode solo doit fonctionner avant
    // login. Écriture **bloquée côté client** : seed/override pushé via
    // `functions/scripts/seed_daily_challenges.js` (admin SDK).
    //
    // Schéma attendu d'un doc : voir `Devinette.toJson()` côté Dart.
    // Le client tolère le doc absent (fallback bundle local).
    match /daily_challenges/{dateId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // UGC — soumissions
    // -------------------------------------------------------------------------
    match /submissions/{submissionId} {
      // Lecture : owner ou modérateur.
      allow get, list: if isModerator()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      // Création : par owner uniquement, status forcé à `pending`, App Check
      // enforced via paramètre Firebase console.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'authorUid', 'status', 'lang', 'world', 'country',
          'answer', 'answerNormalized', 'lettersPool',
          'riddle', 'explanation', 'proverb',
          'difficulty', 'tags', 'createdAt'
        ]);

      // Update / delete : Cloud Functions uniquement (admin SDK bypasse les
      // règles). Aucun client n'a le droit.
      allow update, delete: if false;
    }

    match /submissions_moderation/{submissionId} {
      allow read: if isModerator();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Reports (flagging d'une devinette communautaire en jeu)
    // -------------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isModerator();
    }

    // -------------------------------------------------------------------------
    // Quotas rate-limiter — 100 % serveur (Cloud Function transactions)
    // -------------------------------------------------------------------------
    match /users_quota/{uid} {
      allow read: if isSignedIn() && uid == request.auth.uid;
      allow write: if false;
    }

    match /ip_quota/{ipHash} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Backoffice — catalog & packs (Phase 1)
    // -------------------------------------------------------------------------
    // Toutes les écritures passent par les CFs admin (functions/src/admin/).
    // Les règles ci-dessous décrivent uniquement les lectures autorisées :
    //   - catalog/* : lecture publique (cf RemoteCatalogRepository Phase 3)
    //   - packs/*   : lecture editor / moderator (UI backoffice)
    //   - audit/*   : lecture admin uniquement (RGPD-friendly)
    //
    // Aucune règle d'écriture client — admin SDK bypass via CFs uniquement.
    // Cf docs/backoffice_schema.md §6 pour la matrice complète.

    match /catalog/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /packs/{packId} {
      allow read: if isEditor() || isModerator();
      allow write: if false;

      match /meta/{metaId} {
        allow read: if isEditor() || isModerator();
        allow write: if false;
      }

      match /i18n/{lang} {
        allow read: if isEditor();
        allow write: if false;
      }

      match /devinettes/{deviId} {
        allow read: if isEditor();
        allow write: if false;
      }

      match /versions/{versionN} {
        allow read: if isEditor();
        allow write: if false;
      }

      match /audit/{logId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Pack Creator (pipeline contenu IA) — lecture editor, écriture serveur
    // -------------------------------------------------------------------------
    // Jobs de création de packs + candidats (staging) + registre de lots.
    // Toutes les écritures passent par les CFs (Admin SDK) ; la console admin
    // lit en temps réel via onSnapshot (file, progression, revue).
    match /pack_jobs/{jobId} {
      allow read: if isEditor();
      allow write: if false;

      match /candidates/{candId} {
        allow read: if isEditor();
        allow write: if false;
      }
      match /batches/{batchIndex} {
        allow read: if isEditor();
        allow write: if false;
      }
    }

    // Lecture collectionGroup des candidats (vue « En attente par pack »,
    // agrège tous les jobs). Écriture serveur uniquement.
    match /{path=**}/candidates/{candId} {
      allow read: if isEditor();
      allow write: if false;
    }

    // Config de ré-approvisionnement hebdomadaire par pack (CF setPackTopup).
    match /pack_topup/{packId} {
      allow read: if isEditor();
      allow write: if false;
    }

    // File « Question du jour » — lecture editor, écriture serveur (CF
    // assignCandidateToDaily + cron fillDailyQueue).
    match /daily_queue/{itemId} {
      allow read: if isEditor();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Users inventory (Phase 4 — wallet serveur cauris-only)
    // -------------------------------------------------------------------------
    // wallet : doc unique cauris + owned_packs + version.
    // audit  : append-only log des mutations (unlock, credit, debit, bootstrap).
    //
    // Lecture autorisée au user pour transparence (peut voir son audit).
    // Écriture exclusivement via CFs (bootstrapWallet, unlockPack, creditCauris,
    // syncWallet — toutes en europe-west1, cf functions/src/wallet/).
    //
    // Cf docs/wallet_server_schema.md §6.
    match /users/{uid}/inventory/wallet {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid}/inventory_audit/{logId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;  // append-only via CFs
    }

    // Fallback pour autres sous-collections d'inventory : lecture self, jamais write.
    match /users/{uid}/inventory/{docId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Progression solo (sauvegarde multi-appareil) — player_progress/{uid}
    // -------------------------------------------------------------------------
    // Miroir cloud de la progression solo (niveaux, étoiles, séries, freeze
    // tokens, packs possédés, modifiers rencontrés…) pour la récupération
    // après réinstallation/changement d'appareil. Lecture/écriture limitées
    // au propriétaire.
    //
    // ⚠️ Le solde de **cauris** n'est JAMAIS stocké ici : c'est une monnaie,
    // autorité serveur via le wallet Cloud Functions (users/{uid}/inventory).
    // On refuse explicitement les clés `cauris`/`coins` pour fermer tout
    // vecteur d'inflation via un doc client-inscriptible.
    match /player_progress/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && !('cauris' in request.resource.data)
        && !('coins' in request.resource.data);
    }

    // -------------------------------------------------------------------------
    // Default deny
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
