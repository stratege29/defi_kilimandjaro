rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Profils joueurs ---
    // Lecture publique pour afficher l'ELO dans le lobby.
    // Écriture ELO/stats UNIQUEMENT via Admin SDK (Cloud Functions endMatch / requestMatch).
    // Exception : le client peut écrire uniquement fcm_token et fcm_updated_at
    // (nécessaire pour l'enregistrement FCM côté app, sans passer par une CF).
    match /profiles/{uid} {
      allow read: if request.auth != null;

      // Écriture générale bloquée (Admin SDK seulement).
      allow write: if false;

      // Le joueur peut mettre à jour uniquement les champs autorisés client-side
      // (FCM + display_name pour le leaderboard) sur son propre profil.
      // Les champs ELO/wins/losses/total_duels/peakElo restent Admin SDK-only.
      // update : le document existe déjà (créé par Admin SDK via requestMatch).
      //   diff().affectedKeys() garantit qu'aucun autre champ n'est touché.
      // create : cas edge où le profil n'existe pas encore.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fcm_token', 'fcm_updated_at', 'display_name', 'display_name_updated_at']);

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys()
             .hasOnly(['fcm_token', 'fcm_updated_at', 'display_name', 'display_name_updated_at']);
    }

    // --- Friendships (unidirectional follow) ---
    // friendships/{follower_uid}/{followed_uid} : { created_at: timestamp }
    // Le follower crée/supprime ses propres entrées. Lecture publique
    // (utilisée par d'autres pour voir leur popularité — feature future).
    match /friendships/{followerUid}/followed/{followedUid} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
        && request.auth.uid == followerUid;
      allow update: if false;
    }

    // --- Historique des matchs ---
    // Lecture autorisée aux participants du match uniquement.
    // Écriture UNIQUEMENT via Admin SDK (Cloud Function endMatch).
    match /matches_history/{matchId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.players;
      allow write: if false;
    }

    // --- Quotas rate-limiter (usage interne Functions) ---
    match /users_quota/{uid} {
      allow read, write: if false;
    }

    // --- Tout le reste est refusé par défaut ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
